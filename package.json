{
  "name": "moligod-toolbox",
  "description": "Windows 本地游戏工具箱，提供自定义准星与可视化自动化助手",
  "license": "SEE LICENSE IN LICENSE-EXCEPTION",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-budget.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "test:core": "cargo test -p moligod-core -p moligod-storage --locked",
    "test": "node --test tests/*.test.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "modules:dev": "node scripts/build-modules.mjs",
    "modules:sync": "npm run modules:dev && npm run modules:build",
    "modules:build": "node scripts/build-modules.mjs --release",
    "modules:package": "node scripts/build-modules.mjs --release --package"
  },
  "dependencies": {
    "@blockly/plugin-scroll-options": "13.4.0",
    "@tauri-apps/api": "^2",
    "blockly": "13.4.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1",
    "@tauri-apps/cli": "^2",
    "prettier": "3.9.9",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
